{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "transfer"
    },
    "source": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string",
          "description": "Hostname or IP address of the source Windows machine"
        },
        "directory": {
          "type": "string",
          "description": "Source directory path",
          "default": "."
        },
        "fileRegex": {
          "type": "string",
          "description": "Regular expression pattern to match files"
        },
        "fileWatch": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "integer",
              "description": "Timeout in seconds for file watching"
            },
            "directory": {
              "type": "string",
              "description": "Directory to watch for files"
            },
            "fileRegex": {
              "type": "string",
              "description": "File pattern to watch for"
            }
          },
          "required": ["timeout", "directory", "fileRegex"]
        },
        "logWatch": {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "integer",
              "description": "Timeout in seconds for log watching"
            },
            "directory": {
              "type": "string",
              "description": "Directory containing the log file"
            },
            "log": {
              "type": "string",
              "description": "Log file name to watch"
            },
            "contentRegex": {
              "type": "string",
              "description": "Content pattern to watch for in the log"
            },
            "tail": {
              "type": "boolean",
              "description": "Whether to tail the log file",
              "default": false
            }
          },
          "required": ["timeout", "directory", "log", "contentRegex"]
        },
        "conditionals": {
          "type": "object",
          "properties": {
            "size": {
              "type": "object",
              "properties": {
                "gt": {
                  "type": "integer",
                  "description": "File size greater than (bytes)"
                },
                "lt": {
                  "type": "integer",
                  "description": "File size less than (bytes)"
                }
              }
            },
            "age": {
              "type": "object",
              "properties": {
                "gt": {
                  "type": "integer",
                  "description": "File age greater than (seconds)"
                },
                "lt": {
                  "type": "integer",
                  "description": "File age less than (seconds)"
                }
              }
            }
          }
        },
        "postCopyAction": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": ["move", "rename", "delete"],
              "description": "Action to perform after copying"
            },
            "destination": {
              "type": "string",
              "description": "Destination path for move action"
            }
          },
          "required": ["action"]
        },
        "protocol": {
          "$ref": "protocol.json"
        }
      },
      "required": ["hostname", "protocol"]
    },
    "destination": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hostname": {
            "type": "string",
            "description": "Hostname or IP address of the destination"
          },
          "directory": {
            "type": "string",
            "description": "Destination directory path"
          },
          "transferType": {
            "type": "string",
            "enum": ["push", "pull"],
            "default": "push",
            "description": "Transfer type: push from source or pull to destination"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "description": "Group to set on transferred files"
              }
            }
          },
          "rename": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regex pattern for file renaming"
              },
              "sub": {
                "type": "string",
                "description": "Replacement string for renaming"
              }
            },
            "required": ["pattern", "sub"]
          },
          "protocol": {
            "type": "object",
            "description": "Protocol configuration for destination (if different from source)"
          }
        },
        "required": ["hostname", "directory"]
      }
    }
  },
  "required": ["type", "source"],
  "anyOf": [
    { "required": ["destination"] },
    {
      "properties": {
        "source": {
          "required": ["fileWatch"]
        }
      }
    },
    {
      "properties": {
        "source": {
          "required": ["logWatch"]
        }
      }
    }
  ]
}
